--cpu=Cortex-M4.fp.sp
".\obj\system_m460.o"
".\obj\startup_m460.o"
".\obj\retarget.o"
".\obj\uart.o"
".\obj\sys.o"
".\obj\clk.o"
".\obj\timer.o"
".\obj\canfd.o"
".\obj\main.o"
".\obj\bridge_host_link.o"
".\obj\bridge_hw_abstraction.o"
".\obj\bridge_nuvoisp_can.o"
