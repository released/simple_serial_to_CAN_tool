static uint8_t can_wait_ack_blocking(uint32_t expect_cmd,
                                     uint32_t *out_data,
                                     uint32_t timeout_ms,
                                     uint32_t *out_last_rx_cmd,
                                     uint32_t *out_last_rx_data)
{
